{
  "name": "@browserrecon/cli",
  "version": "0.1.0",
  "private": true,
  "description": "browserrecon command-line interface",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browserrecon/attack-surface": "workspace:*",
    "@browserrecon/auth": "workspace:*",
    "@browserrecon/authorization": "workspace:*",
    "@browserrecon/browser-manager": "workspace:*",
    "@browserrecon/browser-runner": "workspace:*",
    "@browserrecon/collector-network": "workspace:*",
    "@browserrecon/config": "workspace:*",
    "@browserrecon/core": "workspace:*",
    "@browserrecon/coverage": "workspace:*",
    "@browserrecon/deterministic-explorer": "workspace:*",
    "@browserrecon/event-store": "workspace:*",
    "@browserrecon/events": "workspace:*",
    "@browserrecon/exporter-json": "workspace:*",
    "@browserrecon/exporter-markdown": "workspace:*",
    "@browserrecon/orchestrator": "workspace:*",
    "@browserrecon/policy": "workspace:*",
    "@browserrecon/rate-controller": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "bin": {
    "browserrecon": "./bin/browserrecon.js"
  },
  "files": [
    "bin",
    "dist"
  ]
}
