{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gauravchauhan15/browserrecon/schemas/attack-surface/attack-surface.schema.json",
  "title": "BrowserRecon attack surface",
  "description": "The unified, scanner-consumable model (build plan §23). Every item resolves back to raw observations via source_event_ids (§35B.5).",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "session_id", "target", "items", "coverage_caveat"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Bumped when this shape changes."
    },
    "session_id": {
      "type": "string",
      "pattern": "^sess_[0-9]{4,}$"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "coverage_caveat": {
      "type": "string",
      "minLength": 1,
      "description": "§10C.6. Required and non-empty: a consumer must not be able to render this model without the statement that it describes reachable surface, not the application."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surfaceItem"
      }
    }
  },
  "$defs": {
    "surfaceItem": {
      "type": "object",
      "required": [
        "surface_id",
        "kind",
        "identity",
        "provenance",
        "auth_context",
        "source_event_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^srf_[0-9]{4,}$"
        },
        "kind": {
          "type": "string",
          "enum": ["api_endpoint", "route", "form", "websocket", "webmcp_tool", "origin"]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": ["observed", "correlated", "derived", "inferred", "candidate"]
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^wf_[0-9]{4,}$"
        },
        "workflow_step": {
          "type": "integer",
          "minimum": 1
        },
        "api_id": {
          "type": "string",
          "pattern": "^api_[0-9]{4,}$"
        },
        "interaction_id": {
          "type": "string",
          "pattern": "^int_[0-9]{4,}$"
        },
        "navigation_id": {
          "type": "string",
          "pattern": "^nav_[0-9]{4,}$"
        },
        "state_before": {
          "type": "string"
        },
        "state_after": {
          "type": "string"
        },
        "auth_context": {
          "type": "string",
          "minLength": 1,
          "description": "§12.3 point 4. Never absent: an observation that does not know which identity produced it cannot be compared with one that does."
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{4,}$"
          },
          "description": "§35B.5. At least one, always — a derived object without resolvable source ids is a bug, so the schema refuses an empty list rather than leaving it to a reviewer."
        },
        "semantic": {
          "type": "object",
          "description": "Added by M4+. Absent at Tier 0, which is not the same as empty — §35B.6 requires the deterministic content to be byte-identical between tiers."
        }
      }
    }
  }
}
