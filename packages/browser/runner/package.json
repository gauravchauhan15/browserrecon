{
  "name": "@browserrecon/browser-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Launches a browser, attaches telemetry, and visits pages under policy",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browserrecon/browser-adapter": "workspace:*",
    "@browserrecon/browser-manager": "workspace:*",
    "@browserrecon/collector-interaction": "workspace:*",
    "@browserrecon/collector-network": "workspace:*",
    "@browserrecon/core": "workspace:*",
    "@browserrecon/deterministic-explorer": "workspace:*",
    "@browserrecon/discovery-external": "workspace:*",
    "@browserrecon/events": "workspace:*",
    "@browserrecon/policy": "workspace:*",
    "@browserrecon/rate-controller": "workspace:*",
    "@browserrecon/telemetry-cdp": "workspace:*"
  }
}
