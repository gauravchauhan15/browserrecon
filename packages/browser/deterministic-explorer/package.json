{
  "name": "@browserrecon/deterministic-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "The rule-based driver: what to visit next, under policy, in a reproducible order",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browserrecon/browser-adapter": "workspace:*",
    "@browserrecon/collector-dom": "workspace:*",
    "@browserrecon/core": "workspace:*",
    "@browserrecon/events": "workspace:*",
    "@browserrecon/policy": "workspace:*"
  }
}
