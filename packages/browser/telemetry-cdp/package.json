{
  "name": "@browserrecon/telemetry-cdp",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime telemetry over raw CDP: every request the browser makes, normalized into events",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browserrecon/core": "workspace:*",
    "@browserrecon/events": "workspace:*",
    "@browserrecon/policy": "workspace:*",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "@browserrecon/browser-manager": "workspace:*",
    "@browserrecon/collector-network": "workspace:*",
    "@browserrecon/fixtures": "workspace:*"
  }
}
