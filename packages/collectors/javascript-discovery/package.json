{
  "name": "@browserrecon/collector-javascript-discovery",
  "version": "0.0.0",
  "private": true,
  "description": "JS asset inventory: what was loaded, hashed and deduplicated \u2014 no parsing",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.ts",
      "default": "./dist/reconcile.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@browserrecon/core": "workspace:*",
    "@browserrecon/events": "workspace:*",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0"
  }
}
