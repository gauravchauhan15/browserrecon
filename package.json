{
  "name": "browserrecon-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Browser runtime recon — monorepo root",
  "license": "Apache-2.0",
  "author": "Gaurav Chauhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauravchauhan15/browserrecon.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "typecheck:tests": "tsc --build && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "tsc --build && vitest run tests/golden",
    "test:golden:update": "node scripts/update-golden.mjs",
    "verify": "node scripts/verify.mjs",
    "new-package": "node scripts/new-package.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "schemas": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
